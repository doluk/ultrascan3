+// Hindered settling of (sticky) hard spheres, Fiore et al. 2018 (SI Eqs. 11-16)
+static inline void hindered_factors( double phi, const US_MFHook* hk, double& hs, double& hd )
+{
+   phi = qBound( 0.0, phi, 0.6 );
+   const double om = 1.0 - phi;
